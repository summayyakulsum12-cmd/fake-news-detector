# Copy this file to .env and fill in the values you need.

# Which LLM provider to use for the "understanding" half of the hybrid model.
# Options: anthropic | openai | gemini | (leave blank to use the offline heuristic fallback)
LLM_PROVIDER=gemini

# Only one of these is required, matching LLM_PROVIDER above.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Hybrid combination weights (must sum to any positive total, they're normalized).
ML_WEIGHT=0.35
LLM_WEIGHT=0.65

# Flask
FLASK_DEBUG=false
PORT=5000
